# URL pública del sitio. En local: http://localhost:3000
# En producción: https://tu-dominio.com (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo visible en la página, si existe. No inventar.
# NEXT_PUBLIC_CONTACT_EMAIL=contacto@dominio.com

# Destinatario del formulario. Variable privada, nunca NEXT_PUBLIC_.
# CONTACT_EMAIL=contacto@dominio.com

# Remitente verificado en Resend, si se usa ese canal.
# CONTACT_FROM_EMAIL=OCPX Technologies <hola@dominio.com>

# API key de Resend. Nunca exponer al cliente.
# RESEND_API_KEY=

# Webhook opcional (CRM, Make, n8n, Zapier). Si está definido, se envía el JSON del formulario.
# CONTACT_WEBHOOK_URL=

# Google Analytics. No activar con un ID ficticio.
# Si se habilita, puede ser necesario un banner de consentimiento.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
